DB_URL=jdbc:mysql://localhost:3306/sptrngboot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=sptrngboot
DB_PASSWORD=change-me
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Free / low-cost alternative: Groq (OpenAI-compatible API)
# 1) Create a Groq key at https://console.groq.com/keys
# 2) Copy the key below
OPENAI_API_KEY=your-groq-api-key
OPENAI_MODEL=groq/compound-mini
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_SYSTEM_PROMPT=あなたは親切で役立つアシスタントです。簡潔かつ丁寧に回答してください。
PORT=8090

# For local MySQL testing set to 'mysql'. For production use 'production'.
# SPRING_PROFILES_ACTIVE=mysql
SPRING_PROFILES_ACTIVE=production
